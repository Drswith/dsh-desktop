{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Launcher",
  "version": "0.1.0",
  "identifier": "io.github.drswith.dsh-launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dsh-launcher"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "© 2026 Drswith",
    "shortDescription": "DSH 的菜单栏启动器",
    "longDescription": "常驻托盘的小外壳：启动本地 dsh web 服务，就绪后从菜单里在默认浏览器打开它。",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
