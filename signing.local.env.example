# Copy to signing.local.env (git-ignored) to sign builds with your certificate.
# Full certificate name, as listed by: security find-identity -v -p codesigning
CODESIGN_IDENTITY="${CODESIGN_IDENTITY:-Apple Development: you@example.com (ABCDE12345)}"
# Team ID: the OU of that certificate (not the ID in the name's parentheses).
CODESIGN_TEAM_ID="${CODESIGN_TEAM_ID:-ABCDE12345}"
